#!/usr/bin/env python3
"""Fetch wttr.in on demand with bounded timeouts and a local stale-cache fallback."""
import argparse
import datetime
import hashlib
import json
import os
import subprocess
import sys
import tempfile
import time
import urllib.parse
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from cc import paths, preferences, sanitize


def display(cache, location, stale=False):
    stamp = datetime.datetime.fromtimestamp(cache.stat().st_mtime).astimezone().strftime("%Y-%m-%d %H:%M %Z")
    print(f"WEATHER · {sanitize(location)} · {'STALE · ' if stale else ''}updated {stamp}\n")
    print(sanitize(cache.read_text()), end="")


def main():
    parser = argparse.ArgumentParser(description="Weather from wttr.in, cached for 30 minutes by default")
    parser.add_argument("--refresh", action="store_true")
    args = parser.parse_args()
    settings = preferences()
    location = str(settings.get("weather_location", "")).strip()
    if not location:
        print("Set weather_location in " + str(paths()[0] / "preferences.json"))
        return 1
    try:
        ttl = int(settings.get("weather_cache_seconds", 1800))
    except (TypeError, ValueError) as error:
        raise ValueError("weather_cache_seconds must be a whole number of seconds") from error
    if ttl < 0:
        raise ValueError("weather_cache_seconds must be nonnegative")
    _, _, cache_dir = paths()
    folder = cache_dir / "weather"
    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
    cache = folder / (hashlib.sha256(location.encode()).hexdigest()[:24] + ".txt")
    if not args.refresh and cache.exists() and time.time() - cache.stat().st_mtime < ttl:
        display(cache, location)
        return 0
    url = "https://wttr.in/" + urllib.parse.quote(location, safe="") + "?1&T&Q&lang=en"
    try:
        response = subprocess.run(["curl", "--fail", "--silent", "--show-error", "--connect-timeout", "5",
                                   "--max-time", "15", "--proto", "=https", url],
                                  capture_output=True, text=True, timeout=17)
        text = response.stdout
        invalid = (response.returncode != 0 or not text.strip() or len(text) > 100000
                   or "<html" in text.lower() or "unknown location" in text.lower()
                   or "sorry" in text.lower() or "error" in text.lower())
        if invalid:
            raise ValueError("Weather service did not return a forecast")
        # Service text is data, not terminal instructions: keep the layout, drop escapes.
        text = sanitize(text)
        with tempfile.NamedTemporaryFile(mode="w", dir=folder, delete=False) as handle:
            handle.write(text)
            temporary = Path(handle.name)
        temporary.replace(cache)
        display(cache, location)
        return 0
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        print("Weather unavailable: " + str(error), file=sys.stderr)
        if cache.exists():
            display(cache, location, stale=True)
            return 0
        print("No cached forecast yet. Try: command-center weather --refresh", file=sys.stderr)
        return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print("cc-weather: " + str(error), file=sys.stderr)
        sys.exit(1)
