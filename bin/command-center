#!/usr/bin/env python3
"""Launch and customize existing terminal tools through Zellij."""
import argparse
import datetime
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from cc import ROOT, layout_source, paths, preferences, render_layout, seed, tool_env, valid_name, zellij_config

WORKSPACES = ("dev", "system", "agents", "news-weather", "operations")
TOOLS = ("shell", "hermes", "opencode", "pi", "codex", "btop", "newsboat",
         "weather", "lazygit", "yazi", "lazydocker", "logs", "services")
ZCONFIG = ROOT / "config/zellij/config.kdl"


def parser():
    p = argparse.ArgumentParser(description="An optional Zellij workspace; Ghostty stays a normal terminal.")
    p.add_argument("--project", type=Path, help="Working directory for a NEW session")
    p.add_argument("--session", help="Named session (default: command-center, or command-center-WORKSPACE)")
    p.add_argument("--theme", choices=("command-center", "oh-my-pi"), default="command-center",
                   help="Zellij theme for a NEW session; Ghostty and app preferences are separate")
    group = p.add_mutually_exclusive_group()
    group.add_argument("--workspace", choices=WORKSPACES, help="Launch one workspace in its own session")
    group.add_argument("--layout", help="Built-in or saved layout for a NEW session")
    sub = p.add_subparsers(dest="action")
    sub.add_parser("doctor", help="Check installed tools and settings")
    sub.add_parser("update", help="Pull the checkout's upstream updates (clean tree, fast-forward only)")
    sub.add_parser("layouts", help="List built-in and saved layouts")
    sub.add_parser("reset", help="Launch or reattach to fresh-start (same as --session fresh-start)")
    apps = sub.add_parser("apps", help="Search configured installed apps and browse public catalogs")
    apps.add_argument("--inline", action="store_true", help="Use this shell pane rather than a floating menu")
    catalogs = sub.add_parser("catalogs", help="Choose and search a public tool catalog")
    catalogs.add_argument("--source", choices=("terminal-trove", "awesome-tuis", "awesome-cli", "homebrew"))
    catalogs.add_argument("--query", default="", help="Initial search text")
    catalogs.add_argument("--refresh", action="store_true", help="Refresh the selected source's cache")
    catalogs.add_argument("--list", action="store_true", help="Print sources or matching tools without fzf")
    catalogs.add_argument("--inline", action="store_true", help="Use this shell pane rather than a floating menu")
    run = sub.add_parser("run", help="Run a configured tool in this terminal or the current shell pane")
    run.add_argument("tool", choices=TOOLS)
    run.add_argument("tool_args", nargs=argparse.REMAINDER, help="Arguments passed directly to the tool")
    save = sub.add_parser("save-layout", help="Save current Zellij layout without replacing an existing file")
    save.add_argument("name")
    pane = sub.add_parser("pane", help="Open a tool pane in the current command-center session")
    pane.add_argument("tool", choices=TOOLS)
    place = pane.add_mutually_exclusive_group()
    place.add_argument("--floating", action="store_true")
    place.add_argument("--direction", choices=("right", "down"))
    pane.add_argument("--cwd", type=Path)
    pane.add_argument("--name", help="Optional fixed title; default is the shell/application title")
    pane.add_argument("--compact", action="store_true", help="Use the small-pane btop configuration")
    tab = sub.add_parser("add-workspace", help="Add a workspace tab to the current command-center session")
    tab.add_argument("workspace", choices=WORKSPACES)
    tab.add_argument("--cwd", type=Path)
    weather = sub.add_parser("weather", help="Show a cached forecast")
    weather.add_argument("--refresh", action="store_true")
    sub.add_parser("detach", help="Return to your normal terminal, leaving panes running")
    titles = sub.add_parser("titles", help="Clear fixed pane titles to allow automatic shell/application titles")
    titles.add_argument("--all", action="store_true", help="Clear fixed titles on all terminal panes in this session")
    return p


def directory(path):
    value = (path or Path.cwd()).expanduser().resolve()
    if not value.is_dir():
        raise ValueError("Directory does not exist: " + str(value))
    return value


def zellij(theme="command-center"):
    executable = shutil.which("zellij", path=tool_env()["PATH"])
    if not executable:
        raise ValueError("Zellij is missing. Run ./install.sh, or install Zellij 0.45.1+ with your package manager")
    # Zellij 0.45.1 needs a config-dir to resolve absolute serialized layout paths
    # during resurrection, even when its configuration was supplied explicitly.
    config, _, _ = paths()
    return [executable, "--config-dir", str(config / "zellij"), "--config", str(zellij_config(theme))]


def inside():
    if not os.environ.get("ZELLIJ"):
        raise ValueError("Run this command from a panel inside command-center")
    # Restored sessions may have an older server environment; explicit commands use the current root.
    return zellij()


def main():
    args = parser().parse_args()
    if args.action == "update":
        from cc_update import update
        return update(ROOT)
    if args.action == "reset":
        args.session, args.workspace, args.layout = "fresh-start", None, None
    if args.action == "doctor":
        env = tool_env()
        missing = []
        for tool in ("zellij", "btop", "newsboat", "lazygit", "curl", "python3", "fzf",
                     "hermes", "opencode", "pi", "codex", "yazi", "lazydocker", "docker"):
            executable = shutil.which(tool, path=env["PATH"])
            label = "required" if tool in ("zellij", "btop", "newsboat", "lazygit", "curl", "python3", "fzf") else "optional"
            detail = executable or "not installed"
            if executable and tool in ("zellij", "btop", "newsboat", "lazygit"):
                flag = "-v" if tool == "newsboat" else "--version"
                result = subprocess.run([executable, flag], capture_output=True, text=True, timeout=10)
                detail += " — " + (result.stdout.splitlines() or ["version unavailable"])[0]
            print(f"{tool:12} {label:8} {detail}")
            if not executable and label == "required":
                missing.append(tool)
        config, data, cache = paths()
        print(f"\nPreferences: {config / 'preferences.json'}\nFeeds:       {config / 'feeds'}\nLayouts:     {data / 'layouts'}\nCache:       {cache}")
        print("Weather:     " + str(preferences().get("weather_location", "not set")))
        if not missing:
            result = subprocess.run(zellij(args.theme) + ["setup", "--check"], env=env, capture_output=True, text=True)
            if result.returncode:
                print(result.stdout + result.stderr, file=sys.stderr)
                return 1
            print("Zellij configuration: valid\nGhostty startup: normal shell (no auto-start configured by this project)")
        return int(bool(missing))
    if args.action == "layouts":
        _, data, _ = paths()
        for kind, folder in (("built-in", ROOT / "config/zellij/layouts"), ("saved", data / "layouts")):
            for path in sorted(folder.glob("*.kdl")):
                print(f"{path.stem:24} {kind}")
        return 0
    if args.action in ("apps", "catalogs"):
        import cc_catalogs
        listing = args.action == "catalogs" and args.list
        if not listing and os.environ.get("ZELLIJ") and not args.inline:
            forwarded = sys.argv[1:] + ["--inline"]
            subprocess.run(inside() + ["action", "new-pane", "--floating", "--close-on-exit",
                                      "--cwd", str(Path.cwd()), "--", str(ROOT / "bin/command-center"),
                                      *forwarded], env=tool_env(), check=True)
            return 0
        if args.action == "apps":
            if not sys.stdin.isatty() or not sys.stdout.isatty():
                raise ValueError("Open apps from an interactive terminal")
            cc_catalogs.apps_menu()
            return 0
        if args.refresh and not args.source:
            raise ValueError("Choose --source NAME when using --refresh")
        return cc_catalogs.run_catalogs(args)
    if args.action == "weather":
        os.execve(str(ROOT / "bin/cc-weather"), ["cc-weather"] + (["--refresh"] if args.refresh else []), tool_env())
    if args.action == "run":
        seed()
        if args.tool == "shell" and os.environ.get("ZELLIJ"):
            subprocess.run(inside() + ["action", "rename-pane", ""], env=tool_env(), check=True)
        tool_args = args.tool_args
        if tool_args[:1] == ["--"]:
            tool_args = tool_args[1:]
        os.execve(str(ROOT / "bin/cc-panel"), ["cc-panel", args.tool, *tool_args], tool_env())
    if args.action == "save-layout":
        command = inside()
        name = valid_name(args.name)
        seed()
        _, data, _ = paths()
        target = data / "layouts" / (name + ".kdl")
        if target.exists():
            raise ValueError("Layout already exists; choose a new name or edit it: " + str(target))
        result = subprocess.run(command + ["action", "dump-layout"], env=tool_env(), capture_output=True, text=True, check=True)
        if "layout" not in result.stdout:
            raise ValueError("Zellij did not return a layout")
        with target.open("x") as handle:
            handle.write(result.stdout)
        target.chmod(0o600)
        print("Saved " + str(target))
        print(f"Use for a new session: command-center --layout {name} --session {name}")
        return 0
    if args.action == "detach":
        subprocess.run(inside() + ["action", "detach"], env=tool_env(), check=True)
        return 0
    if args.action == "pane":
        if args.compact and args.tool != "btop":
            raise ValueError("--compact is currently supported for btop")
        seed()
        command = inside() + ["action", "new-pane"]
        if args.name:
            command += ["--name", args.name]
        if args.floating:
            command += ["--floating"]
        if args.direction:
            command += ["--direction", args.direction]
        command += ["--cwd", str(directory(args.cwd)), "--", str(ROOT / "bin/cc-panel"), args.tool]
        if args.compact:
            command.append("--compact")
        subprocess.run(command, env=tool_env(), check=True)
        return 0
    if args.action == "titles":
        command = inside()
        targets = [None]
        if args.all:
            seed()
            _, data, _ = paths()
            snapshot = subprocess.run(command + ["action", "dump-layout"], env=tool_env(),
                                      capture_output=True, text=True, check=True)
            stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            backup = data / "layouts" / ("before-auto-titles-" + stamp + "-" + str(os.getpid()) + ".kdl")
            with backup.open("x") as handle:
                handle.write(snapshot.stdout)
            backup.chmod(0o600)
            print("Previous arrangement and titles saved: " + str(backup))
            result = subprocess.run(command + ["action", "list-panes", "--json", "--all"],
                                    env=tool_env(), capture_output=True, text=True, check=True)
            targets = ["terminal_" + str(pane["id"]) for pane in json.loads(result.stdout)
                       if not pane.get("is_plugin")]
        for target in targets:
            action = command + ["action", "rename-pane", ""]
            if target:
                action += ["--pane-id", target]
            subprocess.run(action, env=tool_env(), check=True)
        print("Fixed titles cleared. Existing shells can enable command titles with: command-center run shell")
        return 0
    if args.action == "add-workspace":
        layout = render_layout(args.workspace, directory(args.cwd))
        subprocess.run(inside() + ["action", "new-tab", "--layout-string", layout], env=tool_env(), check=True)
        return 0
    if os.environ.get("ZELLIJ") or os.environ.get("TMUX"):
        raise ValueError("Already inside a multiplexer. Use 'command-center pane TOOL' or launch from a normal Ghostty shell.")
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise ValueError("Launch command-center from an interactive terminal such as Ghostty")
    project = directory(args.project)
    name = valid_name(args.session or ("command-center-" + args.workspace if args.workspace else "command-center"))
    layout_name = args.layout or args.workspace or "command-center"
    command = zellij(args.theme)
    seed()
    # Passing a layout while attaching would add tabs. Only new sessions receive a layout.
    listed = subprocess.run(command + ["list-sessions", "--no-formatting", "--short"],
                            env=tool_env(), capture_output=True, text=True, timeout=10)
    sessions = [line.split()[0] for line in listed.stdout.splitlines() if line.strip()]
    if name in sessions:
        if args.project or args.layout or args.workspace:
            print("Reattaching to existing session; its directories and arrangement are preserved.")
        os.execvpe(command[0], command + ["attach", name], tool_env())
    layout = render_layout(layout_name, project)
    os.chdir(project)
    os.execvpe(command[0], command + ["--layout-string", layout, "attach", "--create", name], tool_env())


if __name__ == "__main__":
    try:
        sys.exit(main() or 0)
    except (ValueError, OSError, subprocess.TimeoutExpired) as error:
        print("command-center: " + str(error), file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as error:
        print("command-center: tool exited with status " + str(error.returncode), file=sys.stderr)
        sys.exit(error.returncode or 1)
