// Starting template: rearrange freely and save your own version.
layout {
    cwd "{{PROJECT}}"
    default_tab_template {
        pane size=1 borderless=true { plugin location="zellij:tab-bar"; }
        children
        pane size=2 borderless=true { plugin location="zellij:status-bar"; }
    }
    tab name="DEV" focus=true {
        pane split_direction="vertical" {
            pane size="60%" focus=true
            pane split_direction="horizontal" {
                pane command="{{CC_PANEL}}" start_suspended=true {
                    args "lazygit"
                }
                pane
                pane
            }
        }
    }
    tab name="SYSTEM" {
        pane command="{{CC_PANEL}}" start_suspended=true size="60%" focus=true {
            args "btop" "--compact"
        }
        pane split_direction="vertical" size="40%" {
            pane
            pane
        }
    }
    tab name="AGENTS" {
        pane split_direction="vertical" {
            pane split_direction="horizontal" {
                pane command="{{CC_PANEL}}" start_suspended=true focus=true {
                    args "hermes"
                }
                pane command="{{CC_PANEL}}" start_suspended=true {
                    args "opencode"
                }
            }
            pane split_direction="horizontal" {
                pane command="{{CC_PANEL}}" start_suspended=true {
                    args "pi"
                }
                pane command="{{CC_PANEL}}" start_suspended=true {
                    args "codex"
                }
            }
        }
    }
    tab name="NEWS & WEATHER" {
        pane split_direction="vertical" {
            pane command="{{CC_PANEL}}" start_suspended=true size="60%" focus=true {
                args "newsboat"
            }
            pane command="{{CC_PANEL}}" start_suspended=true size="40%" {
                args "weather"
            }
        }
    }
    tab name="OPERATIONS" {
        pane split_direction="vertical" {
            pane split_direction="horizontal" {
                pane command="{{CC_PANEL}}" start_suspended=true focus=true {
                    args "logs"
                }
                pane command="{{CC_PANEL}}" start_suspended=true {
                    args "services"
                }
            }
            pane split_direction="horizontal" {
                pane command="{{CC_PANEL}}" start_suspended=true {
                    args "lazygit"
                }
                pane command="{{CC_PANEL}}" start_suspended=true {
                    args "lazydocker"
                }
            }
        }
    }
}
