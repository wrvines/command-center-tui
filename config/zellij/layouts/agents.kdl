// Starting template: rearrange freely and save your own version.
layout {
    cwd "{{PROJECT}}"
    default_tab_template {
        pane size=1 borderless=true { plugin location="zellij:tab-bar"; }
        children
        pane size=2 borderless=true { plugin location="zellij:status-bar"; }
    }
    tab name="AGENTS" {
        pane split_direction="vertical" {
            pane split_direction="horizontal" {
                pane name="HERMES" command="{{CC_PANEL}}" start_suspended=true focus=true {
                    args "hermes"
                }
                pane name="OPENCODE" command="{{CC_PANEL}}" start_suspended=true {
                    args "opencode"
                }
            }
            pane split_direction="horizontal" {
                pane name="PI" command="{{CC_PANEL}}" start_suspended=true {
                    args "pi"
                }
                pane name="CODEX CLI" command="{{CC_PANEL}}" start_suspended=true {
                    args "codex"
                }
            }
        }
    }
}
