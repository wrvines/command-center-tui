// Starting template: rearrange freely and save your own version.
layout {
    cwd "{{PROJECT}}"
    default_tab_template {
        pane size=1 borderless=true { plugin location="zellij:tab-bar"; }
        children
        pane size=2 borderless=true { plugin location="zellij:status-bar"; }
    }
    tab name="NEWS & WEATHER" {
        pane split_direction="vertical" {
            pane command="{{CC_PANEL}}" start_suspended=true size="60%" focus=true {
                args "apps"
            }
            pane command="{{CC_PANEL}}" start_suspended=true size="40%" {
                args "apps"
            }
        }
    }
}
